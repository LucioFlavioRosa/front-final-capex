    "test:watch": "vitest",
    "test:integracao": "vitest run --config vitest.integracao.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.7",
    "@tanstack/react-query": "5.62.7",
    "react": "^18.3.1",
