{
  "name": "ses-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Plataforma de Otimização de Sequenciamento de Obras de Esgotamento Sanitário (SES) — Aegea",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
